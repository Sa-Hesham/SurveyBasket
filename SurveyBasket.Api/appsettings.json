{
  "Serilog": {

    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
     
      {

        "Name": "File",
        "Args": {
          "Path": "D:\\Logs\\Log-.txt",
          "rollingInterval": "Day",
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter,Serilog.Formatting.Compact"
        }

      }



    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "SurveyBasket"
    }

  },

    "ConnectionStrings": {
      "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=SurveyBasketDb;Trusted_Connection=True;TrustServerCertificate=True"
    },

    "JWT": {

      "Key": "",
      "Issuer": "SurveyBasketApp",
      "Audience": "SurveyBasketAppuser",
      "ExpireMinutes": 15
    },

    "AllowedHosts": "*"

  }
